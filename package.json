{
  "name": "@jimtech/medallion",
  "version": "0.2.0",
  "private": true,
  "description": "Server-side TypeScript SDK for Medallion CDC and audit ingestion.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jim-technologies/medallion-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/jim-technologies/medallion-sdk/issues"
  },
  "homepage": "https://github.com/jim-technologies/medallion-sdk#readme",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/*.cjs",
    "dist/*.js",
    "dist/*.map",
    "dist/*.d.ts",
    "dist/THIRD_PARTY_LICENSES.txt",
    "LICENSE",
    "NOTICE",
    "README.md",
    "VERSION"
  ],
  "scripts": {
    "build": "tsup && node scripts/generate_third_party_licenses.mjs --write && tsc -p tsconfig.build.json",
    "check:examples": "tsc --ignoreConfig --noEmit --target ES2024 --lib ES2024,DOM --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --types node examples/ingestion.ts examples/audit-trail.ts",
    "clean": "rm -rf dist coverage",
    "format": "biome check --write .",
    "lint": "tsc --noEmit && biome ci .",
    "prepare": "npm run build",
    "proto:descriptor": "node scripts/embed-connect-descriptor.mjs",
    "test": "vitest run && node --test scripts/test_third_party_licenses.mjs",
    "test:deployed": "vitest run test/deployed-smoke.test.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@jim-technologies/invariant-protocol": "github:jim-technologies/invariantprotocol#f924e602582402476f257571852fabb0e1e1cf43",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
