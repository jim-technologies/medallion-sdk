{
  "name": "@jimtech/medallion",
  "version": "0.3.1",
  "private": true,
  "description": "Server-side TypeScript SDK for getting data into and out of Medallion: tables, batch appends, and SQL queries.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jim-technologies/medallion-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/jim-technologies/medallion-sdk/issues"
  },
  "homepage": "https://github.com/jim-technologies/medallion-sdk#readme",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/*.cjs",
    "dist/*.js",
    "dist/*.map",
    "dist/*.d.ts",
    "dist/THIRD_PARTY_LICENSES.txt",
    "LICENSE",
    "NOTICE",
    "README.md",
    "VERSION"
  ],
  "scripts": {
    "build": "tsup && node scripts/generate_third_party_licenses.mjs --write && tsc -p tsconfig.build.json",
    "check:examples": "tsc --ignoreConfig --noEmit --target ES2024 --lib ES2024,DOM --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --types node examples/ingestion.ts examples/audit-trail.ts examples/tables.ts",
    "clean": "rm -rf dist coverage",
    "format": "biome check --write .",
    "lint": "tsc --noEmit && biome ci .",
    "prepare": "npm run build",
    "proto:descriptor": "node scripts/embed-connect-descriptor.mjs",
    "test": "vitest run && node --test scripts/test_third_party_licenses.mjs",
    "test:deployed": "vitest run test/deployed-smoke.test.ts test/tables-live.test.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@jim-technologies/invariant-protocol": "github:jim-technologies/invariantprotocol#535d6ca5cf41f6e1029da0946a754e6724a5cf69",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
